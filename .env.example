# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
EXPLORER=https://sepolia.basescan.org

# ---------------------------------------------------------------------------
# Keys (demo wallets only, tiny funds, NEVER commit real keys)
# ---------------------------------------------------------------------------
# Deploys the contracts
DEPLOYER_PK=
# The owner is the user's own browser wallet. The agent NEVER holds this key.
OWNER_ADDRESS=
# Agent hot key: can only spend within caps and call emergencyPause()
AGENT_PK=
AGENT_ADDRESS=

# ---------------------------------------------------------------------------
# Contracts (filled after deploy)
# ---------------------------------------------------------------------------
# Leave VAULT_ADDRESS empty to run the agent in SIMULATED mode (local ledger
# that enforces the same rules as the contract, no chain calls, no tx hashes).
VAULT_ADDRESS=
USDC_ADDRESS=

# ---------------------------------------------------------------------------
# Demo recipients (see demo/seed.ts)
# ---------------------------------------------------------------------------
RECIPIENT_TUITION=0x7a0000000000000000000000000000000000c0de
RECIPIENT_RAHIM=0x2b0000000000000000000000000000000000beef

# ---------------------------------------------------------------------------
# LLM (optional: without a key the agent uses the deterministic fallback planner)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Agent service
# ---------------------------------------------------------------------------
PORT=8787
AUDIT_FILE=./audit.jsonl
AGENT_DB=./guardian.db
WEB_ORIGIN=http://localhost:3000

# Risk / policy defaults (token base units, 6 decimals)
PER_TX_CAP=50000000
DAILY_CAP=150000000
